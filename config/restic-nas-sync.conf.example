# Configuration for restic-nas-backup
# Copy this file to /etc/restic-nas-sync.conf on the backup server.

RESTIC_DATA="/srv/rest-server/data"
MOUNT_POINT="/mnt/restic"
NAS_IP=""
NAS_SHARE="Restic"
REST_SERVER_CONTAINER="rest-server"
RSYNC_OPTIONS="-aHAX --numeric-ids --delete-delay"

# Optional credentials for non-interactive operations (e.g. restic-nas verify, automated restore).
# If omitted or left empty, restic prompts interactively for the password.
# RESTIC_PASSWORD_FILE="/etc/restic.key"
# RESTIC_PASSWORD=""

# Backup schedule.
# Examples:
#   BACKUP_TIME="13:00"
#   BACKUP_DAYS="Mon..Sun"       # every day
#   BACKUP_DAYS="Mon,Wed,Fri"    # selected days
BACKUP_TIME="13:00"
BACKUP_DAYS="Mon..Sun"
